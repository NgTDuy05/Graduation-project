# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MySQL Configuration (Relational Data: users, classes, assignments, submissions, gamification)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smartlearn_db
MYSQL_SYNCHRONIZE=true

# MongoDB Configuration (Flexible Data: lessons, flashcards, question bank, chat messages, announcements)
MONGODB_URI=mongodb://localhost:27017/smartlearn_db

# JWT Authentication
JWT_SECRET=smartlearn_access_token_secret_key_2026_super_secure
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=smartlearn_refresh_token_secret_key_2026_super_secure
JWT_REFRESH_EXPIRATION=7d
