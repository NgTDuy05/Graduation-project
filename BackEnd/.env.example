# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# MySQL / TiDB Cloud Configuration (Relational Data: users, classes, assignments, submissions, gamification)
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_tidb_user.root
MYSQL_PASSWORD=your_tidb_password
MYSQL_SSL=true
MYSQL_SSL_CA=certs/isrgrootx.pem
MYSQL_DATABASE=smartlearn-db
MYSQL_SYNCHRONIZE=false

# MongoDB Atlas Configuration (Flexible Data: lessons, flashcards, question bank, chat messages, announcements)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.k3tli5.mongodb.net/smartlearn_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=smartlearn_access_token_secret_key_2026_super_secure
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=smartlearn_refresh_token_secret_key_2026_super_secure
JWT_REFRESH_EXPIRATION=7d

# Google Gemini AI Configuration (Gia sư AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
